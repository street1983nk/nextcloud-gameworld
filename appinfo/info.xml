<?xml version="1.0"?>
<!--
	ExApp-Manifest von Gameworld.

	Version, Image-Tag und pyproject.toml laufen im Lockstep (tests/test_info_xml.py).

	Routen: Die URLs sind reguläre Ausdrücke, die AppAPI und HaRP gegen den Pfad
	MIT führendem Schrägstrich prüfen. Darum die kanonische Form ^/<pfad>, nicht
	der nackte Pfad: den nimmt AppAPI 34 nur noch über einen als veraltet
	markierten Rückfall an (ExAppProxyController::passesExAppProxyRoutesChecks),
	HaRP gar nicht.

	Reihenfolge ist Semantik: Die erste Route, die zu Pfad und Verb passt,
	gewinnt. Darum stehen die festen Routen (Seite, Bundle, eigene Daten) vor dem
	Auffangmuster ^/api/.*. AppAPI hängt keinen End-Anker an, darum endet
	^/api/me$ auf "$" (sonst träfe es auch /api/members).

	Seit Phase 6 gibt es keine ADMIN-Stufe mehr: AppAPI prüft ADMIN nur als
	IGroupManager::isAdmin, Gameworld hat aber eigene Verwalter-Gruppen
	(ROLLE-03, RESEARCH F-03). Darum steht auch ^/api/.* auf USER, und die
	einzige Sperre der Verwaltung ist require_verwalter bzw. require_nc_admin
	(Admin-Abschnitt /api/admin/) in Python. tests/test_route_guards.py belegt
	für jede Route unter /api/ (außer /api/me und /api/my/), dass eine der
	beiden Sperren im Abhängigkeitsbaum steckt.

	^/talk/bot$ ist der Webhook des Gameworld-Bots. AppAPI ruft ihn aus
	TalkBotController::proxyTalkMessage direkt per requestToExApp auf, nachdem es
	die Talk-Signatur geprüft hat; diese Routenliste wird dabei nicht befragt
	(geprüft in AppAPI 34). Die Route steht trotzdem hier, mit der niedrigsten
	Stufe für angemeldete Nutzer, damit ein strengerer Proxy (HaRP) sie kennt.
	Prüfpunkt für Phase 6. Der Handler verwirft jeden Inhalt ungelesen.

	Browser-Spike 04.2: ^/api/my/play-ticket$ (nur POST) und ^/play/.* sind die
	Ticket-Route und die Spielseite samt Artefakten und WebSocket. Ohne
	GAMEWORLD_BROWSER_SPIKE antworten sie mit 404. HaRP prüft ^/play/.* auch
	beim WebSocket-Upgrade. Sie bleiben bewusst stehen (D-23): AppAPI kennt
	keine Routen-Migration, ein späteres Einschalten bräuchte sonst eine
	Neuinstallation. tests/test_route_guards.py belegt die 404.

	Es gibt bewusst keine Einstellung, die eine Welt im Internet sichtbar macht
	(ZUGANG-01).
-->
<info>
	<id>gameworld</id>
	<name>Gameworld</name>
	<summary>Private Luanti worlds for families and schools, running on your own Nextcloud</summary>
	<description><![CDATA[What Gameworld is:
- Private Luanti worlds for families, created with one click
- Runs on your own Nextcloud server, world data stays at home
- Every world is private: only invited Nextcloud accounts can join
- Hardened game containers with fixed memory, CPU and process limits

Requirements:
- Nextcloud 32 to 34 with AppAPI
- A scoped docker-socket-proxy next to the deploy daemon (see the documentation)]]></description>
	<version>0.1.0</version>
	<licence>AGPL-3.0-or-later</licence>
	<author>street1983nk</author>
	<namespace>Gameworld</namespace>
	<category>games</category>
	<website>https://github.com/street1983nk/nextcloud-gameworld</website>
	<bugs>https://github.com/street1983nk/nextcloud-gameworld/issues</bugs>
	<repository type="git">https://github.com/street1983nk/nextcloud-gameworld.git</repository>
	<dependencies>
		<nextcloud min-version="32" max-version="34"/>
	</dependencies>
	<external-app>
		<docker-install>
			<registry>ghcr.io</registry>
			<image>street1983nk/gameworld</image>
			<image-tag>0.1.0</image-tag>
		</docker-install>
		<routes>
			<route>
				<url>^/js/.*</url>
				<verb>GET</verb>
				<access_level>USER</access_level>
				<headers_to_exclude>[]</headers_to_exclude>
			</route>
			<route>
				<url>^/img/.*</url>
				<verb>GET</verb>
				<access_level>USER</access_level>
				<headers_to_exclude>[]</headers_to_exclude>
			</route>
			<route>
				<url>^/api/me$</url>
				<verb>GET</verb>
				<access_level>USER</access_level>
				<headers_to_exclude>[]</headers_to_exclude>
			</route>
			<route>
				<url>^/api/my/.*</url>
				<verb>GET</verb>
				<access_level>USER</access_level>
				<headers_to_exclude>[]</headers_to_exclude>
			</route>
			<route>
				<url>^/api/my/play-ticket$</url>
				<verb>POST</verb>
				<access_level>USER</access_level>
				<headers_to_exclude>[]</headers_to_exclude>
			</route>
			<route>
				<url>^/play/.*</url>
				<verb>GET,POST</verb>
				<access_level>USER</access_level>
				<headers_to_exclude>[]</headers_to_exclude>
			</route>
			<route>
				<url>^/talk/bot$</url>
				<verb>POST</verb>
				<access_level>USER</access_level>
				<headers_to_exclude>[]</headers_to_exclude>
			</route>
			<route>
				<url>^/api/.*</url>
				<verb>GET,POST,DELETE</verb>
				<access_level>USER</access_level>
				<headers_to_exclude>[]</headers_to_exclude>
			</route>
		</routes>
		<environment-variables>
			<variable>
				<name>GAMEWORLD_DOCKER_URL</name>
				<display-name>Docker proxy URL</display-name>
				<description>Address of the scoped tecnativa docker-socket-proxy. Never point this at a raw Docker socket.</description>
				<default>tcp://gameworld-docker-proxy:2375</default>
			</variable>
			<variable>
				<name>GAMEWORLD_PORT_RANGE</name>
				<display-name>UDP port range for worlds</display-name>
				<description>First and last UDP port for game worlds, for example 30000-30019. One port per world.</description>
				<default>30000-30019</default>
			</variable>
		</environment-variables>
	</external-app>
</info>
